PORT=8000
NODE_ENV=development

# Multi-document transactions REQUIRE a replica set (see docker-compose.yml).
MONGODB_MASTER_URI=mongodb://127.0.0.1:27017/ledgerguard_master?replicaSet=rs0
# Enable later with Docker: REDIS_URL=redis://127.0.0.1:6379
# Until then the ledger uses an in-process lock.

JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_EXPIRES_IN=15m
JWT_ISSUER=ledgerguard
JWT_AUDIENCE=ledgerguard-api

COOKIE_NAME=lg_token
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info
REQUIRE_REQUEST_SIGNATURE=false

# Week 1 seeded demo users (ignored in production). Never reuse real passwords.
SEED_USER_PASSWORD=password123

# Week 2 DEMO ONLY. Ignored when NODE_ENV=production.
# LEDGER_DEMO_FAIL_ACCOUNT=fail_account
