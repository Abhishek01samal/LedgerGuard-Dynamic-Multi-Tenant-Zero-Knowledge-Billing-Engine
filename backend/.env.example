PORT=8000
NODE_ENV=development

# Multi-document transactions REQUIRE a replica set (see docker-compose.yml, Person 4).
MONGODB_MASTER_URI=mongodb://127.0.0.1:27017/ledgerguard_master?replicaSet=rs0

JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_EXPIRES_IN=15m
JWT_ISSUER=ledgerguard

COOKIE_NAME=lg_token
FRONTEND_URL=http://localhost:5173

# Week 1 seeded demo users (ignored in production). Never reuse real passwords.
SEED_USER_PASSWORD=password123

# Week 2 DEMO ONLY: a ledger transaction whose creditAccount equals this value is rolled back
# on purpose (shows atomic rollback in the mid-project review). Ignored when NODE_ENV=production.
# LEDGER_DEMO_FAIL_ACCOUNT=fail_account

# Person 2 adds REDIS_URL=redis://127.0.0.1:6379 in their own PR.
